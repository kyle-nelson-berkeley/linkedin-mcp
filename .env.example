# linkedin-mcp credentials — copy to ~/.config/linkedin-mcp/.env (chmod 600).
# Values are entered by the HUMAN owner only; agents must never write or echo them.
# Client id/secret come from https://www.linkedin.com/developers/apps (Auth tab).
LINKEDIN_CLIENT_ID=your-client-id-here
LINKEDIN_CLIENT_SECRET=your-client-secret-here
# Filled automatically by the auth_start tool after you approve in the browser:
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_ACCESS_TOKEN_EXPIRES_AT=
# LINKEDIN_REFRESH_TOKEN=
# Optional override (default shown):
# LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
